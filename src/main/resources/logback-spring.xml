<configuration>

    <!-- JSON appender -->
    <appender name="JSON_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder
          class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

            <providers>

                <!-- timestamp -->
                <timestamp>
                    <fieldName>timestamp</fieldName>
                </timestamp>

                <!-- log level -->
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>

                <!-- logger -->
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>

                <!-- thread -->
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>

                <!-- MDC values -->
                <mdc/>

                <!-- message -->
                <pattern>
                    <pattern>{"message":"%message"}</pattern>
                </pattern>

            </providers>

        </encoder>

    </appender>


    <!-- normal console logs -->
    <appender name="PLAIN"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level - %logger{36} - %msg%n</pattern>
        </encoder>

    </appender>


    <!-- framework logs -->
    <root level="INFO">

        <appender-ref ref="PLAIN"/>

    </root>


    <!-- application logs -->
    <logger name="com.sb.video.streaming"
            level="INFO"
            additivity="false">

        <appender-ref ref="JSON_CONSOLE"/>

    </logger>

</configuration>